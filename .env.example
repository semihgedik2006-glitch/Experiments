# Postgres-Datenbank (z.B. Neon: https://neon.tech - Connection String aus dem Dashboard)
DATABASE_URL="postgresql://USER:PASSWORT@HOST/DATENBANK?sslmode=require"

# Geheimer Schlüssel für Admin-Sessions - unbedingt durch einen eigenen, zufälligen Wert ersetzen
AUTH_SECRET="changeme"

# Admin-Zugang (wird beim Ausführen von `npm run db:seed` angelegt)
ADMIN_EMAIL="admin@koerperformen.com"
ADMIN_PASSWORD="changeme"

# Optional: Google Analytics Measurement-ID
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# E-Mail-Versand für Buchungsbestätigungen (https://resend.com - API Key im Dashboard unter "API Keys")
# Ohne gesetzten Key wird die Bestätigungs-Mail einfach übersprungen (kein Fehler).
# RESEND_API_KEY="re_xxx"
# Erst nutzbar, sobald eine eigene Domain bei Resend verifiziert ist (Dashboard -> Domains)
# BOOKING_EMAIL_FROM="Körperformen <info@koerperformen.com>"

# Optional: schützt den täglichen Cron-Job, der wiederkehrende Verfügbarkeiten
# automatisch nachfüllt (/api/cron/generate-slots). Ein beliebiger zufälliger Wert.
# CRON_SECRET="ein-zufaelliger-wert"
