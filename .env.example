# Postgres-Datenbank (z.B. Neon: https://neon.tech - Connection String aus dem Dashboard)
DATABASE_URL="postgresql://USER:PASSWORT@HOST/DATENBANK?sslmode=require"

# Geheimer Schlüssel für Admin-Sessions - unbedingt durch einen eigenen, zufälligen Wert ersetzen
AUTH_SECRET="changeme"

# Admin-Zugang (wird beim Ausführen von `npm run db:seed` angelegt)
ADMIN_EMAIL="admin@koerperformen.com"
ADMIN_PASSWORD="changeme"

# Optional: Google Analytics Measurement-ID
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# E-Mail-Versand (https://resend.com - API Key im Dashboard unter "API Keys")
#
# Ohne diesen Schlüssel verschickt die Website KEINE einzige E-Mail: keine
# Eingangsbestätigung an den Interessenten, keine Benachrichtigung ans Studio,
# keine Terminbestätigung und keine Erinnerung. Die Abläufe laufen trotzdem,
# nur der letzte Schritt endet ins Leere. Im Adminbereich steht der Zustand
# unter "E-Mail-Versand".
# RESEND_API_KEY="re_xxx"
#
# Absenderadresse. Erst nutzbar, sobald eine eigene Domain bei Resend
# bestätigt ist (Dashboard -> Domains). Ohne bestätigte Domain nimmt der
# Anbieter nur Mails an die eigene Adresse an.
# BOOKING_EMAIL_FROM="Körperformen <info@koerperformen.com>"
#
# Sammeladresse für alles, was nicht an einen einzelnen Standort geht:
# Kontaktnachrichten und Anfragen ohne gewähltes Studio. Anfragen mit Studio
# gehen an die E-Mail-Adresse, die beim Studio hinterlegt ist. Fehlt beides,
# unterbleibt die Benachrichtigung.
# TEAM_EMAIL="info@koerperformen.com"

# Optional: schützt den täglichen Cron-Job, der wiederkehrende Verfügbarkeiten
# automatisch nachfüllt (/api/cron/generate-slots). Ein beliebiger zufälliger Wert.
# CRON_SECRET="ein-zufaelliger-wert"
