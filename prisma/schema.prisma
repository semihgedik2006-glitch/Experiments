// Prisma schema for the Körperformen EMS studio website
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Wer darf was.
///
/// LEITUNG sieht und ändert alles. STUDIOLEITUNG sieht nur den eigenen
/// Standort: dessen Buchungen, Termine und Studiodaten - und nichts von
/// Blog, Kommentaren, Newsletter, Sichtbarkeit oder Datensicherung. Bei
/// vierzehn Standorten ist ein einziger Zugang für alle nicht haltbar.
enum AdminRole {
  LEITUNG
  STUDIOLEITUNG
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         AdminRole @default(LEITUNG)
  /// Nur für STUDIOLEITUNG gesetzt: der Standort, für den dieser Zugang
  /// gilt. Wird das Studio gelöscht, bleibt der Zugang bestehen, sieht
  /// dann aber nichts mehr - besser als ein Zugang, der plötzlich alles
  /// sieht.
  studio       StudioLocation? @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId     String?
  createdAt    DateTime @default(now())
}

/// Welche Art E-Mail verschickt wurde.
///
/// Die Namen stehen dauerhaft in der Datenbank. Fällt eine Art später weg,
/// bleiben alte Einträge lesbar - deshalb wird hier nichts umbenannt.
enum MailArt {
  /// An den Interessenten, sobald seine Anfrage angekommen ist.
  ANFRAGE_EINGANG
  /// An das Studio, sobald eine Anfrage da ist.
  ANFRAGE_INTERN
  /// An das Studio, wenn eine Anfrage zu lange offen liegt.
  NACHFASS_INTERN
  /// An das Team, sobald eine Kontaktnachricht da ist.
  KONTAKT_INTERN
  BESTAETIGUNG
  ERINNERUNG
  ABSAGE_GAST
  VERSCHOBEN_GAST
  /// Nach dem Termin: die Bitte um eine Bewertung.
  BEWERTUNG
  /// An den Ersten auf der Warteliste, wenn ein Platz frei wird.
  WARTELISTE_FREI
  WARTELISTE_INTERN
  /// Eine Newsletter-Ausgabe an einen Abonnenten.
  NEWSLETTER
  /// Der Probeversand an die eigene Adresse. Eigene Art, damit ein
  /// Testlauf im Protokoll nicht wie ein Versand an einen Kunden aussieht.
  NEWSLETTER_TEST
  /// Der Zugangslink zum eigenen Terminbereich.
  KUNDENBEREICH
}

/// Nachweis, dass eine E-Mail den Weg nach draußen gefunden hat.
///
/// Ohne diesen Nachweis lässt sich die häufigste Frage nicht beantworten:
/// "Hat der Kunde die Bestätigung bekommen?" Im Adminbereich steht damit
/// schwarz auf weiß, was wann an wen ging - und was nicht ging.
///
/// Der Inhalt der Mail wird NICHT gespeichert, nur Empfänger und Betreff.
/// Für die Frage "ist sie rausgegangen" genügt das, und ein Abzug der
/// Datenbank enthält damit keine vollständigen Nachrichten.
model MailLog {
  id         String   @id @default(cuid())
  art        MailArt
  empfaenger String
  betreff    String
  ok         Boolean
  /// Die Meldung des Anbieters, falls es schiefging.
  fehler     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Ein Aktionscode aus einer Anzeige, einem Flyer oder einer Kooperation.
///
/// Der Code wird im Anfrageformular eingegeben und an der Anfrage
/// festgehalten. Damit lässt sich hinterher sagen, welche Anzeige
/// tatsächlich Anfragen gebracht hat - und nicht nur, welche Klicks.
model Promotion {
  id          String    @id @default(cuid())
  /// Immer in Großbuchstaben gespeichert. Wer "sommer26" tippt, meint
  /// denselben Code wie "SOMMER26" - alles andere wäre eine Falle.
  code        String    @unique
  /// Wofür der Code steht, für den Adminbereich: "Anzeige Kölner
  /// Wochenspiegel, KW 30".
  label       String
  /// Was der Gast bekommt. Erscheint als Bestätigung im Formular, sobald
  /// der Code angenommen wurde.
  benefit     String?
  active      Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  bookings    Booking[]
}

model StudioLocation {
  id            String             @id @default(cuid())
  admins        AdminUser[]
  bookings      Booking[]
  warteliste    Warteliste[]
  /// Der Ort in der Adresse: /studio/koeln-nippes. Wird aus dem Namen
  /// gebildet (siehe src/lib/slug.ts) und lässt sich im Adminbereich
  /// ändern - dann sollte man wissen, dass alte Verweise ins Leere gehen.
  slug          String             @unique
  name          String
  street        String
  postalCode    String
  city          String
  phone         String
  email         String
  mapEmbedUrl   String
  openingHours  String
  /// Zwei, drei Sätze über genau diesen Standort - was das Studio
  /// auszeichnet, wer dort trainiert, was es in der Nähe gibt. Ohne diesen
  /// Text unterscheiden sich die vierzehn Standortseiten nur in der
  /// Adresse, und fast gleiche Seiten wertet Google ab.
  intro         String?
  /// Der Weg zum Studio in eigenen Worten: Parkplätze, Haltestelle,
  /// Eingang im Hinterhof. Genau danach wird lokal gesucht, und es steht
  /// auf keiner anderen Seite.
  anfahrt       String?
  /// Link, unter dem man diesem Standort eine Google-Bewertung schreibt.
  /// Ohne ihn unterbleibt die Bitte um eine Bewertung - eine Mail, die
  /// jemanden auf die Suche schickt, bringt keine Bewertung.
  googleReviewUrl String?
  /// WhatsApp-Nummer dieses Standorts. Getrennt vom Telefonfeld, weil
  /// nicht jede Festnetznummer bei WhatsApp erreichbar ist.
  whatsapp      String?
  latitude      Float?
  longitude     Float?
  sortOrder     Int                @default(0)
  updatedAt     DateTime           @updatedAt
  slots         AvailabilitySlot[]
  slotTemplates SlotTemplate[]
  trainer       Trainer[]
  empfehlungen  Empfehlung[]
  verwandlungen Verwandlung[]
  stimmen       Kundenstimme[]
}

/// Wer im Studio betreut.
///
/// Der Anlass: Ein Probetraining bedeutet, sich vor einem Fremden in enge
/// Trainingskleidung zu stellen und sich Elektroden anlegen zu lassen. Wer
/// vorher weiß, wer ihn erwartet, überwindet diese Hürde leichter - ein
/// Gesicht und zwei Sätze wirken hier mehr als jede weitere Erklärung zum
/// Training selbst.
///
/// Je Standort und nicht für die Marke: Bei vierzehn Studios wäre eine
/// gemeinsame Teamseite die Aussage "irgendwer von diesen vierzehn" - also
/// keine.
model Trainer {
  id       String         @id @default(cuid())
  studio   StudioLocation @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId String
  name     String

  /// "Studioleitung", "Trainerin", "Physiotherapeut" - eine Zeile.
  rolle String?

  /// Ausbildung und Lizenzen, kurz. Bewusst ein freies Feld und keine
  /// Auswahlliste: Was hier steht, muss stimmen, und niemand außer dem
  /// Studio kann das beurteilen.
  qualifikation String?

  /// Zwei, drei Sätze in eigenen Worten. Was ihn ausmacht, nicht was EMS
  /// ist - das steht auf jeder anderen Seite schon.
  text String?

  /// Adresse eines Fotos, wie beim Titelbild eines Blogbeitrags. Ohne Foto
  /// erscheint ein Feld mit den Anfangsbuchstaben, kein leerer Rahmen.
  fotoUrl String?

  /// Ausgeblendet statt gelöscht: Wer im Urlaub ist oder das Studio
  /// wechselt, soll nicht neu angelegt werden müssen.
  aktiv     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, sortOrder])
}

/// Der Zugang zu Instagram.
///
/// Warum in der Datenbank und nicht in einer Umgebungsvariablen: Der
/// Schlüssel von Instagram läuft nach 60 Tagen ab und muss vorher gegen
/// einen neuen getauscht werden. Ein neuer Wert lässt sich aber nicht in
/// eine Umgebungsvariable zurückschreiben - die Wand wäre also nach zwei
/// Monaten still verschwunden, und niemand hätte gewusst warum.
///
/// Genau eine Zeile, festgenagelt über id = "instagram". Ein zweiter
/// Zugang ergäbe keinen Sinn, und ohne festen Schlüssel entstünde beim
/// zweiten Speichern eine zweite Zeile.
model ExternerZugang {
  id String @id

  /// Der Schlüssel selbst. Er steht nie auf einer Seite und wird im
  /// Adminbereich nur als Länge und Ablaufdatum angezeigt.
  token String

  /// Wann er ungültig wird. Danach holt die Seite nichts mehr.
  laeuftAb DateTime?

  /// Wann zuletzt erneuert wurde - für die Anzeige im Adminbereich.
  erneuertAm DateTime?

  /// Was beim letzten Abruf schiefging, falls etwas schiefging.
  letzterFehler String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// A recurring weekly pattern (e.g. "every Monday 09:00-09:30") that
// automatically keeps generating real AvailabilitySlot rows going
// forward, until the template itself is deleted.
model SlotTemplate {
  id        String             @id @default(cuid())
  studio    StudioLocation     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId  String
  weekday   Int // 0 = Sonntag ... 6 = Samstag
  startTime String
  endTime   String
  capacity  Int                @default(1)
  createdAt DateTime           @default(now())
  slots     AvailabilitySlot[]
}

model AvailabilitySlot {
  id         String        @id @default(cuid())
  studio     StudioLocation @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId   String
  template   SlotTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  date       DateTime
  startTime  String
  endTime    String
  capacity   Int            @default(1)
  bookings   Booking[]
  warteliste Warteliste[]
  createdAt  DateTime       @default(now())
}

/// Wer benachrichtigt werden will, wenn ein belegter Termin frei wird.
///
/// Bis hierher endete eine ausgebuchte Zeit in einer Fehlermeldung - und
/// damit meistens im Abbruch. Ein Eintrag auf dieser Liste ist dagegen ein
/// Interessent mit Namen und Telefonnummer, der genau weiß, wann er kann.
model Warteliste {
  id       String           @id @default(cuid())
  slot     AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId   String
  /// Doppelt zum Termin gehalten, damit eine Studioleitung ihre Liste auch
  /// dann sieht, wenn der Termin schon weg ist.
  studio   StudioLocation?  @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId String?
  name     String
  email    String
  phone    String
  erreichbarkeit String?
  zuZweit  Boolean          @default(false)
  /// Wann Bescheid gegeben wurde, dass etwas frei ist. Einmal - wer nicht
  /// reagiert, blockiert sonst den Nächsten.
  benachrichtigtAm DateTime?
  createdAt DateTime        @default(now())

  @@index([slotId])
  @@index([studioId])
}

model Booking {
  id        String            @id @default(cuid())
  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  slotId    String?
  /// Der Standort, für den angefragt wurde - unabhängig davon, ob eine
  /// feste Zeit dabei war. Vorher stand er nur mittelbar über den Termin
  /// da, und wer keine Zeit anklickte, landete bei niemandem.
  studio    StudioLocation?   @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId  String?
  name      String
  email     String
  phone     String
  message   String?
  status    BookingStatus     @default(PENDING)
  createdAt DateTime          @default(now())

  // Schlüssel für den persönlichen Link in der Bestätigungsmail, über den
  // der Gast selbst absagen oder verschieben kann. Nicht erratbar und ohne
  // Bezug zur id - wer den Link hat, sieht genau diese eine Buchung.
  manageToken    String?   @unique
  // Wann die Erinnerung am Vortag verschickt wurde. Verhindert, dass der
  // tägliche Lauf dieselbe Erinnerung mehrfach schickt.
  reminderSentAt DateTime?

  /// Interner Vermerk, nur im Adminbereich sichtbar - "ruft morgen zurück",
  /// "will lieber abends". Geht nie in eine E-Mail an den Gast.
  internalNote   String?

  /// Was sich der Gast an Zeit wünschte, in eigenen Worten.
  ///
  /// WIRD NICHT MEHR ABGEFRAGT. Das Feld war doppelt gemoppelt: Die festen
  /// Zeiten stehen zur Auswahl, die telefonische Erreichbarkeit wird
  /// gesondert erfragt, und wann es tatsächlich passt, klärt sich im
  /// Rückruf. Die Spalte bleibt, weil an bereits eingegangenen Anfragen
  /// echter Text von echten Menschen steht - er wird im Adminbereich
  /// weiterhin angezeigt, nur nichts Neues mehr hineingeschrieben.
  terminWunsch   String?

  /// Was der Gast erreichen will - einer der Werte aus src/lib/ziel.ts.
  /// Freiwillig: Eine Anfrage darf nicht daran scheitern, dass jemand sein
  /// Ziel noch nicht benennen kann. Bewusst KEINE Gesundheitsangabe, siehe
  /// die Begründung in src/lib/ziel.ts.
  ziel           String?

  /// Wann der Gast telefonisch am besten erreichbar ist - eine der
  /// Zeitspannen aus src/lib/erreichbarkeit.ts. Pflichtangabe im Formular:
  /// Ohne sie beginnt jede Anfrage mit Rückrufversuchen ins Leere. Als
  /// Text und nicht als Aufzählungstyp, damit sich die Spannen ändern
  /// lassen, ohne die Datenbank umzubauen.
  erreichbarkeit String?

  /// Der eingelöste Aktionscode. Nur gesetzt, wenn er beim Absenden
  /// gültig war - abgelaufene und unbekannte Codes werden im Formular
  /// abgewiesen, damit niemand mit einer Erwartung ins Studio kommt, die
  /// dort niemand kennt.
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionId String?

  /// Der eingelöste Empfehlungscode - jemand hat diese Anfrage geworben.
  /// Steht im selben Feld des Formulars wie der Aktionscode: Für den, der
  /// ihn eingibt, ist es "der Code, den ich bekommen habe"; ihn zwei
  /// Felder unterscheiden zu lassen wäre eine Hürde ohne Nutzen.
  empfehlung   Empfehlung? @relation(fields: [empfehlungId], references: [id], onDelete: SetNull)
  empfehlungId String?

  /// Ob die Prämie für diese geworbene Anfrage abgerechnet wurde.
  ///
  /// Am Buchungsdatensatz und nicht am Empfehlungscode: Ein Code wirbt
  /// mehrfach, und jede geworbene Person ist eine eigene Prämie. Am Code
  /// ließe sich nur "schon mal etwas gezahlt" festhalten.
  praemieGutgeschrieben Boolean @default(false)

  /// Woher die Anfrage kam. Drei Angaben, alle ohne Cookies und ohne
  /// einen Drittanbieter - sie stehen entweder in der aufgerufenen
  /// Adresse oder im Verweis des Browsers:
  ///
  /// herkunftSeite    - auf welcher Seite das Formular stand
  ///                    ("/probetermin", "/aktion/rueckenschmerzen")
  /// herkunftKampagne - die Kennung aus der Adresse (utm_campaign oder k),
  ///                    also das, was ihr selbst in die Anzeige schreibt
  /// herkunftQuelle   - nur der Name der verweisenden Seite, etwa
  ///                    "google.com". Bewusst ohne den Rest der Adresse:
  ///                    Der volle Verweis kann Suchbegriffe und mehr
  ///                    enthalten, und den brauchen wir nicht.
  herkunftSeite    String?
  herkunftKampagne String?
  herkunftQuelle   String?

  /// Wann das Studio über diese Anfrage informiert wurde. Verhindert eine
  /// zweite Benachrichtigung, wenn etwas wiederholt wird.
  studioBenachrichtigtAm DateTime?
  /// Wann zuletzt daran erinnert wurde, dass diese Anfrage offen liegt.
  /// Ohne diesen Merker käme die Erinnerung jeden Tag erneut - und wäre
  /// nach drei Tagen nur noch Rauschen.
  nachfassGesendetAm     DateTime?
  /// Wann nach dem Termin um eine Bewertung gebeten wurde. Einmal, nie
  /// wieder - eine zweite Bitte ist eine Belästigung.
  bewertungGesendetAm    DateTime?

  /// Kommt zu zweit. Belegt dann zwei Plätze des Termins - sonst stünde
  /// bei einem Termin für eine Person plötzlich ein Paar.
  zuZweit                Boolean   @default(false)
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  /// Schlagwörter zu diesem Beitrag, im Adminbereich vergeben.
  ///
  /// Sie tragen zwei Dinge: den Filter in der Blogübersicht und die
  /// verwandten Beiträge unter einem Artikel. Ohne Themen heißt "verwandt"
  /// nur "zuletzt erschienen", und das ist bei wenigen Beiträgen zufällig.
  ///
  /// Als Textliste und nicht als eigene Tabelle: Ein Thema hat keine
  /// Eigenschaft außer seinem Namen, und eine Verknüpfungstabelle für reine
  /// Schlagwörter macht jedes Auslesen aufwendiger, ohne etwas zu können.
  themen      String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Comment {
  id         String    @id @default(cuid())
  post       BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String?
  replies    Comment[] @relation("CommentReplies")
  authorName String
  content    String
  isTeam     Boolean   @default(false)
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  /// Schlüssel für den Abmeldelink in jeder Newsletter-Mail.
  ///
  /// Ohne funktionierende Abmeldung darf ein Newsletter gar nicht erst
  /// rausgehen (§ 7 UWG, Art. 21 DSGVO) - und "schreib uns eine Mail"
  /// genügt dafür nicht. Der Schlüssel ist nicht erratbar und hat keinen
  /// Bezug zur Kennung: Wer den Link hat, meldet genau diese eine Adresse
  /// ab und kann mit ihm sonst nichts anfangen.
  abmeldeToken String @unique
}

enum NewsletterStatus {
  ENTWURF
  /// Der Versand läuft gerade. Ein eigener Zustand, weil er Minuten
  /// dauern kann - ohne ihn sähe eine laufende Ausgabe wie ein Entwurf
  /// aus, und jemand könnte sie ein zweites Mal losschicken.
  LAEUFT
  VERSENDET
}

/// Eine Newsletter-Ausgabe.
///
/// Bis hierher wurden Abonnenten gesammelt, aber es gab keinen Weg, ihnen
/// zu schreiben - die Liste war ein Adressbuch ohne Briefkasten.
///
/// Der Text wird gespeichert, anders als bei MailLog: Eine Ausgabe ist
/// keine Nachricht an einen einzelnen Menschen, sondern eine
/// Veröffentlichung. Was wann an alle ging, muss nachlesbar bleiben.
model Newsletter {
  id      String @id @default(cuid())
  betreff String
  text    String

  status      NewsletterStatus @default(ENTWURF)
  versendetAm DateTime?

  /// Laufend mitgezählt, damit der Fortschritt sichtbar ist, während der
  /// Versand noch läuft.
  zugestellt Int @default(0)
  gescheitert Int @default(0)

  /// Wer den Versand ausgelöst hat - als Adresse, nicht als Verknüpfung.
  /// Ein gelöschter Zugang darf die Nachvollziehbarkeit nicht mitnehmen.
  versendetVon String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empfaenger NewsletterEmpfang[]

  @@index([createdAt])
}

/// Wer eine Ausgabe bekommen hat.
///
/// Zwei Aufgaben, und beide sind der Grund, warum das eine eigene Tabelle
/// ist und keine Zahl an der Ausgabe:
///
/// Erstens der Nachweis. Bei einer Beschwerde ist die Frage nicht "wie
/// viele", sondern "hat DIESE Adresse die Ausgabe bekommen".
///
/// Zweitens das Fortsetzen. Ein Versand an hunderte Adressen passt nicht in
/// einen Durchlauf; er läuft in Abschnitten. Ohne festzuhalten, wer schon
/// dran war, bekäme beim zweiten Abschnitt die halbe Liste alles doppelt.
///
/// Die Adresse steht als Text da, nicht als Verknüpfung zum Abonnenten:
/// Wer sich abmeldet, verschwindet aus der Abonnentenliste - dass die
/// Ausgabe an ihn ging, bleibt trotzdem wahr.
model NewsletterEmpfang {
  id           String     @id @default(cuid())
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId String
  empfaenger   String
  ok           Boolean
  createdAt    DateTime   @default(now())

  @@unique([newsletterId, empfaenger])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String   @unique
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ein-/ausschaltbare Bereiche der Website.
//
// Damit lässt sich ein Teil der Seite vorübergehend ausblenden, solange die
// Inhalte noch nicht stehen - etwa "Über uns" oder die Google-Bewertungen -
// ohne dass jemand Code anfassen muss.
//
// Bewusst als Tabelle mit einem Eintrag je Bereich statt als eine Zeile mit
// vielen Spalten: Ein neuer Bereich braucht dann keine Datenbankänderung.
model SiteToggle {
  // Schlüssel des Bereichs, z.B. "ueber-uns" oder "google-bewertungen".
  key       String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Einzelne Texte, die im Adminbereich änderbar sein müssen.
///
/// Das Gegenstück zu SiteToggle: dort ein Schalter je Bereich, hier ein
/// Text je Schlüssel. Angelegt für den Preishinweis - eine Angabe, die
/// rechtlich gefordert ist (§ 3 PAngV) und deren genauer Wortlaut vom
/// Studio kommen muss, nicht aus dem Code.
///
/// Ein Eintrag entsteht erst beim ersten Speichern; bis dahin gilt der
/// Standardtext aus src/lib/site-texte.ts.
model SiteText {
  key       String   @id
  wert      String
  updatedAt DateTime @updatedAt
}

/// Ein Tarif auf der Preisseite.
///
/// Die Preisseite sagt bisher ausdrücklich, dass hier keine Preisliste
/// steht - und das ist eine bewusste Entscheidung des Studios, keine
/// Lücke. Diese Tabelle ändert daran nichts: Solange kein Tarif
/// eingetragen ist, bleibt die Seite genau so, wie sie ist. Erst wenn das
/// Studio Preise nennen WILL, erscheint die Gegenüberstellung.
model Tarif {
  id   String  @id @default(cuid())
  name String
  /// Eine Zeile darunter: "für den Einstieg", "unsere Empfehlung".
  untertitel String?

  /// Der Preis als TEXT, nicht als Zahl.
  ///
  /// Absicht: "ab 69 €", "auf Anfrage" und "89 € / Monat" sind alle
  /// zulässig und alle keine Zahl. Eine Dezimalspalte würde das Studio
  /// zwingen, sich auf einen Betrag festzulegen, den es vielleicht gar
  /// nicht nennen will - und genau daran ist die Preisseite bisher
  /// bewusst vorbeigeschrieben.
  preis String?
  /// "pro Monat", "je Einheit" - steht klein hinter dem Preis.
  preisZusatz String?

  /// Was enthalten ist, ein Punkt je Eintrag.
  leistungen String[]

  /// Hervorgehoben. Höchstens einer - die Aktion setzt das durch.
  empfohlen Boolean @default(false)

  /// Kleingedrucktes zu genau diesem Tarif, etwa die Mindestlaufzeit.
  hinweis String?

  aktiv     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Was es zusätzlich zum Training gibt.
///
/// Ernährungsberatung und Messungen werden auf der Preisseite erwähnt,
/// hatten aber keinen eigenen Platz - sie standen als Halbsatz in einer
/// Aufzählung von Preisfaktoren. Wer danach sucht, findet sie dort nicht.
model Zusatzangebot {
  id   String  @id @default(cuid())
  name String
  text String?
  /// Wie beim Tarif ein Text: "ab 49 €" oder "im Beitrag enthalten".
  preis String?

  /// Eines von wenigen Sinnbildern - siehe src/lib/zusatzangebote.ts.
  symbol String @default("sonstiges")

  /// Leere Liste heißt: an allen Standorten.
  ///
  /// Bewusst eine Liste am Angebot statt einer Verknüpfungstabelle: Es
  /// gibt nichts, was an der Verbindung zwischen Angebot und Standort
  /// hinge - kein Preis, kein Termin, keine Person. Eine eigene Tabelle
  /// wäre nur ein zweiter Ort zum Pflegen.
  nurStudios String[]

  aktiv     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Vorlage für eine Antwort-E-Mail.
///
/// Die Website verschickt diese Antworten NICHT selbst. Eine Antwort auf
/// eine Kontaktanfrage kommt aus dem Postfach des Studios: Nur so kann der
/// Interessent darauf antworten, nur so steht der Verlauf dort, wo ihn alle
/// sehen, und nur so landet die Antwort nicht als automatische Nachricht im
/// Werbeordner. Die Vorlage öffnet stattdessen das Mailprogramm mit
/// ausgefülltem Empfänger, Betreff und Text.
///
/// Im Text dürfen Platzhalter stehen - siehe src/lib/vorlagen.ts.
model Antwortvorlage {
  id        String   @id @default(cuid())
  /// Kurzer Name für die Auswahlliste im Adminbereich ("Preisanfrage").
  titel     String
  betreff   String
  text      String
  /// Ausgeschaltete Vorlagen bleiben erhalten, tauchen aber nicht mehr in
  /// der Auswahl auf. Besser als löschen: Eine saisonale Vorlage kommt im
  /// nächsten Jahr wieder.
  aktiv     Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktiv, sortOrder])
}

/// Wer wen geworben hat.
///
/// Bewusst kein Kundenkonto: Es gibt keines, und eines dafür zu bauen
/// wäre der falsche Weg herum. Stattdessen legt das Studio je Mitglied
/// einen Code an - der Werbende gibt ihn weiter, der Geworbene trägt ihn
/// ins Anfrageformular ein, und damit ist die Zuordnung da.
///
/// Was die Website ausdrücklich NICHT tut: E-Mails im Namen des Werbenden
/// verschicken. Eine "Empfiehl uns weiter"-Mail an eine Adresse, die der
/// Empfänger nie hinterlassen hat, ist unerlaubte Werbung (§ 7 Abs. 2
/// Nr. 2 UWG) - und zwar für uns, nicht für den Werbenden. Wer empfiehlt,
/// gibt seinen Code selbst weiter.
model Empfehlung {
  id String @id @default(cuid())

  /// Immer in Großbuchstaben gespeichert, wie beim Aktionscode: Wer
  /// "lena-24" tippt, meint denselben Code wie "LENA-24".
  code String @unique

  /// Wer empfiehlt. Name genügt zur Zuordnung; Kontaktdaten sind
  /// freiwillig und nur dafür da, die Prämie auch zustellen zu können.
  name  String
  email String?
  phone String?

  /// Der Standort des Werbenden - damit eine Studioleitung ihre eigenen
  /// Empfehlungen sieht und nicht die aller vierzehn.
  studio   StudioLocation? @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId String?

  /// Was der Werbende bekommt, als Text: "eine Freieinheit", "20 €
  /// Gutschrift". Wie beim Tarifpreis bewusst keine Zahl.
  praemie String?

  /// Interner Vermerk. Geht nie an den Geworbenen.
  notiz String?

  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings Booking[]

  @@index([studioId])
}

enum ProtokollArt {
  ANGELEGT
  GEAENDERT
  GELOESCHT
  /// Alles, was nach draußen geht - ein Newsletter etwa.
  VERSENDET
  /// Statuswechsel an einer Buchung: bestätigt, storniert.
  STATUS
}

/// Wer hat wann was geändert.
///
/// Der Anlass: Seit es mehrere Zugänge gibt, ist "wer hat diese Buchung
/// storniert?" eine Frage, die niemand beantworten kann. Bei vierzehn
/// Standorten und einem Team je Standort wird daraus schnell ein Streit
/// darüber, ob überhaupt jemand etwas geändert hat.
///
/// Was NICHT protokolliert wird: das Lesen. Wer eine Liste öffnet, ändert
/// nichts - und ein Protokoll, in dem jeder Seitenaufruf steht, begräbt
/// genau die Einträge, für die es gedacht ist. Aus demselben Grund stehen
/// hier auch keine Inhalte, sondern nur, worum es ging.
model Protokoll {
  id String @id @default(cuid())

  /// Wer. Als Adresse und nicht als Verknüpfung: Ein gelöschter Zugang
  /// darf die Nachvollziehbarkeit nicht mitnehmen.
  wer String

  art     ProtokollArt
  /// Womit: "Buchung", "Termin", "Studio", "Zugang", "Newsletter".
  bereich String
  /// Worum es ging, in Klartext: "Anfrage von Maria Schmidt".
  betreff String
  /// Was genau passiert ist, wenn der Betreff es nicht sagt.
  detail  String?

  /// Der betroffene Standort, falls es einen gibt.
  studioId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studioId, createdAt])
}

/// Ein Vorher-Nachher-Paar.
///
/// Der heikelste Inhalt der ganzen Website - aus zwei Gründen, die nichts
/// miteinander zu tun haben:
///
/// ERSTENS DAS BILD. Ein Foto, auf dem jemand erkennbar ist, darf nur mit
/// dessen Einwilligung veröffentlicht werden (§ 22 KUG, Art. 6 Abs. 1
/// lit. a DSGVO) - und bei einem Vorher-Nachher-Bild in Unterwäsche gilt
/// das doppelt. Die Einwilligung wird deshalb hier festgehalten, und ohne
/// sie lässt sich der Eintrag nicht veröffentlichen: Die Serveraktion
/// weist es ab, nicht nur die Anzeige.
///
/// ZWEITENS DIE AUSSAGE. Ein Bildpaar behauptet etwas, ohne einen Satz zu
/// sagen. Deshalb gehören der Zeitraum und das, was die Person sonst
/// getan hat, zwingend dazu - vier Kilo in vier Wochen sehen anders aus
/// als vier Kilo in einem Jahr, und wer nebenher die Ernährung umgestellt
/// hat, hat das nicht allein dem Training zu verdanken. Ohne diese
/// Angaben ist es Werbung mit einem Ergebnis, das so niemand erwarten
/// kann - und damit irreführend (§ 5 UWG).
model Verwandlung {
  id String @id @default(cuid())

  /// Vorname oder Initialen. Der volle Name gehört hier nicht hin, auch
  /// nicht mit Einwilligung: Er hilft niemandem und steht danach für
  /// immer in Suchmaschinen.
  name String

  /// Der Zeitraum. Pflicht - siehe oben.
  zeitraum String

  /// Was die Person dabei sonst getan hat. Ebenfalls Pflicht: "zweimal
  /// pro Woche EMS, dazu Ernährungsberatung" ist die ehrliche Angabe,
  /// "durch EMS" wäre die unehrliche.
  kontext String

  /// In eigenen Worten, freigegeben. Freiwillig.
  text String?

  vorherUrl  String
  nachherUrl String

  /// Der Standort, damit eine Studioleitung ihre eigenen Fälle pflegt.
  studio   StudioLocation? @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId String?

  /// Wann die Einwilligung vorlag. OHNE DIESES DATUM GEHT NICHTS RAUS.
  einwilligungAm DateTime?
  /// In welcher Form: "schriftlich", "per E-Mail". Für den Nachweis.
  einwilligungForm String?
  /// Wo das Dokument liegt. Ein Vermerk, kein Anhang - Einwilligungen
  /// gehören in eure Ablage, nicht in eine Website-Datenbank.
  einwilligungNotiz String?

  /// Voreinstellung ausdrücklich FALSCH: Ein Bildpaar erscheint erst,
  /// wenn jemand es bewusst freigibt. Bei jedem anderen Inhalt wäre das
  /// unnötig umständlich, hier ist es der Sinn der Sache.
  aktiv     Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([studioId])
}

/// Ein Zugangslink zum eigenen Terminbereich.
///
/// Kein Konto, kein Passwort - und das ist eine Entscheidung, keine
/// Abkürzung. Wer ein Probetraining anfragt, legt sich dafür kein Konto
/// an; er gibt seine Adresse ein, bekommt einen Link und ist drin. Ein
/// Passwort wäre eine zusätzliche Hürde vor Inhalten, die ohnehin nur aus
/// den eigenen Terminen bestehen - und ein weiteres Passwort, das
/// irgendwo aufgeschrieben wird.
///
/// Drei Dinge machen das trotzdem sicher genug:
///
/// NUR DER ABDRUCK LIEGT HIER. Gespeichert wird der Hash, nicht der
/// Schlüssel. Wer die Datenbank in die Hand bekommt, kann damit keinen
/// Link bauen - und der Schlüssel selbst steht einzig im Postfach dessen,
/// der ihn angefordert hat.
///
/// ER LÄUFT AB. Ein Link, der ein Jahr später noch funktioniert, ist ein
/// offenes Fenster in einem weitergegebenen Postfach.
///
/// ER VERRÄT NICHTS. Die Anforderung antwortet immer gleich, egal ob es
/// zu der Adresse Termine gibt. Sonst wäre das Formular eine Auskunft
/// darüber, wer hier Kunde ist.
model Kundenzugang {
  id String @id @default(cuid())

  /// Immer kleingeschrieben abgelegt, damit "Max@..." und "max@..."
  /// derselbe Mensch sind.
  email String

  /// Der Abdruck des Schlüssels (SHA-256). NIE der Schlüssel selbst.
  tokenHash String @unique

  ablaufAm DateTime

  /// Wann der Link zum ersten Mal geöffnet wurde. Reiner Vermerk - er
  /// beantwortet die Frage "ist die Mail angekommen?", ohne dass jemand
  /// im Postfach nachsehen muss.
  geoeffnetAm DateTime?

  createdAt DateTime @default(now())

  /// Für die Begrenzung je Adresse und fürs Aufräumen.
  @@index([email, createdAt])
  @@index([ablaufAm])
}

/// Eine Kundenstimme.
///
/// Sie ersetzt eine Liste erfundener Zitate im Quelltext. Das war als
/// Platzhalter fürs Layout gedacht und wäre beim Livegang zu einem
/// Problem geworden: Erfundene Bewertungen sind unzulässig (§ 5b Abs. 3
/// UWG), und sie standen nicht irgendwo, sondern auf der Startseite.
///
/// Zwei Dinge sind deshalb wie beim Vorher-Nachher-Bereich gelöst:
///
/// AKTIV STEHT AUF FALSCH. Eine Stimme erscheint erst, wenn jemand sie
/// bewusst freigibt.
///
/// EINE EINWILLIGUNG WIRD FESTGEHALTEN. Ein Zitat mit Namen ist eine
/// personenbezogene Veröffentlichung - auch ohne Bild. Anders als dort
/// ist sie hier aber keine Bedingung fürs Erscheinen: Wer ein Zitat
/// schriftlich schickt, damit es auf die Website kommt, hat damit schon
/// eingewilligt. Das Feld dient dem Nachweis, nicht der Sperre.
model Kundenstimme {
  id String @id @default(cuid())

  /// Vorname und abgekürzter Nachname, so wie die Person es freigibt.
  name String

  /// Das Zitat. In den eigenen Worten der Person - nicht geglättet.
  text String

  /// "Rückengesundheit", "Abnehmen". Freiwillig.
  ziel String?

  /// Wie lange die Person schon trainiert, in Monaten. Freiwillig - und
  /// bewusst eine Zahl und kein Text, damit daraus nicht "seit Jahren"
  /// wird, wenn es acht Monate sind.
  monate Int?

  /// Der Standort, damit eine Studioleitung ihre eigenen Stimmen pflegt.
  studio   StudioLocation? @relation(fields: [studioId], references: [id], onDelete: SetNull)
  studioId String?

  /// Wann die Person zugestimmt hat, dass das auf die Website darf.
  einwilligungAm    DateTime?
  einwilligungNotiz String?

  aktiv     Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([studioId])
}
