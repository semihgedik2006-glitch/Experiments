// Prisma schema for the Körperformen EMS studio website
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model StudioLocation {
  id            String             @id @default(cuid())
  name          String
  street        String
  postalCode    String
  city          String
  phone         String
  email         String
  mapEmbedUrl   String
  openingHours  String
  latitude      Float?
  longitude     Float?
  sortOrder     Int                @default(0)
  updatedAt     DateTime           @updatedAt
  slots         AvailabilitySlot[]
  slotTemplates SlotTemplate[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// A recurring weekly pattern (e.g. "every Monday 09:00-09:30") that
// automatically keeps generating real AvailabilitySlot rows going
// forward, until the template itself is deleted.
model SlotTemplate {
  id        String             @id @default(cuid())
  studio    StudioLocation     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId  String
  weekday   Int // 0 = Sonntag ... 6 = Samstag
  startTime String
  endTime   String
  capacity  Int                @default(1)
  createdAt DateTime           @default(now())
  slots     AvailabilitySlot[]
}

model AvailabilitySlot {
  id         String        @id @default(cuid())
  studio     StudioLocation @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioId   String
  template   SlotTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  date       DateTime
  startTime  String
  endTime    String
  capacity   Int            @default(1)
  bookings   Booking[]
  createdAt  DateTime       @default(now())
}

model Booking {
  id        String            @id @default(cuid())
  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  slotId    String?
  name      String
  email     String
  phone     String
  message   String?
  status    BookingStatus     @default(PENDING)
  createdAt DateTime          @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Comment {
  id         String    @id @default(cuid())
  post       BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String?
  replies    Comment[] @relation("CommentReplies")
  authorName String
  content    String
  isTeam     Boolean   @default(false)
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String   @unique
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ein-/ausschaltbare Bereiche der Website.
//
// Damit lässt sich ein Teil der Seite vorübergehend ausblenden, solange die
// Inhalte noch nicht stehen - etwa "Über uns" oder die Google-Bewertungen -
// ohne dass jemand Code anfassen muss.
//
// Bewusst als Tabelle mit einem Eintrag je Bereich statt als eine Zeile mit
// vielen Spalten: Ein neuer Bereich braucht dann keine Datenbankänderung.
model SiteToggle {
  // Schlüssel des Bereichs, z.B. "ueber-uns" oder "google-bewertungen".
  key       String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
